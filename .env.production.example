# Production example - never commit real values
ENVIRONMENT=production
APP_NAME=MediAI
DATABASE_URL=postgresql+psycopg://medi_ai:<password>@<host>:5432/medi_ai
JWT_SECRET=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
AI_MODE=mock
POSTGRES_DB=medi_ai
POSTGRES_USER=medi_ai
POSTGRES_PASSWORD=<strong-password>
VITE_API_BASE_URL=https://api.example.com
