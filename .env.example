# Core application configuration
APP_NAME=MediAI
ENVIRONMENT=development
API_V1_PREFIX=/api
DEMO_MODE=true

# Database
# For local development, SQLite is used by default. For deployed environments, set DATABASE_URL to your managed Postgres instance.
DATABASE_URL=sqlite:///./medi_ai.db

# Auth / security
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI service
LLM_PROVIDER=mock
LLM_API_KEY=replace-with-real-key
AI_MODE=mock

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Deployment note:
# Copy this file to .env for local development and to an environment secret store for production.
# Never commit real secrets or credentials to version control.
